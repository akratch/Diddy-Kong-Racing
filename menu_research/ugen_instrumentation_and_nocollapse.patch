+        fputc('\n', stderr);
+    }
+    return 0;
+}
+static void ct_exit(int *unused){ (void)unused; if(ct_on()) fprintf(stderr, "%d<\n", ct_depth); ct_depth--; }
+#define CT_FRAME(n,na,x0,x1,x2,x3) __attribute__((cleanup(ct_exit))) int _ctframe = ct_enter(n,na,x0,x1,x2,x3)
