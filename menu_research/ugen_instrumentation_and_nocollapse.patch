+/* UGEN_NOCOLLAPSE */
+static int nc_on(void){static int v=-1; if(v<0)v=getenv("UGEN_NOCOLLAPSE")!=0; return v;}
+/* UGEN_NOCOLLAPSE gate refinement, selected by the value of UGEN_NOCOLLAPSE:
+   "1"/"all" = every ILOD-into-register-dest store
+   "h"       = only 16-bit loads (size==2)
+   "hs"      = only signed 16-bit loads (lh: size==2 && dtype==Jdt(6))
+   "v1"      = only when the destination register is $3 (v1)
+   "v1h"     = dest==$3 and signed 16-bit */
+static int nc_strcmp(const char*a, const char*b){ while(*a && *a==*b){a++;b++;} return *a-*b; }
+static int nc_gate(unsigned dest, unsigned dtype, unsigned size){
+    const char *m = getenv("UGEN_NOCOLLAPSE");
+    if(!m) return 0;
+    if(!nc_strcmp(m,"h"))   return size==2;
+    if(!nc_strcmp(m,"hs"))  return size==2 && dtype==6;
+    if(!nc_strcmp(m,"v1"))  return dest==3;
+    if(!nc_strcmp(m,"v1h")) return dest==3 && size==2 && dtype==6;
+    return 1;
+}
